<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PiSpace</AssemblyName>
    <RootNamespace>PiSpace.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>PiSpace.ico</ApplicationIcon>
    <Version>4.9.3</Version>
    <AssemblyVersion>4.9.3.0</AssemblyVersion>
    <FileVersion>4.9.3.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Content Remove="Tests\**\*" />
    <EmbeddedResource Remove="Tests\**\*" />
    <None Remove="Tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3065.39" />
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\Resources\PiSpace.html" Link="Resources\PiSpace.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Resources\pi-space-bridge.js" Link="Resources\pi-space-bridge.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Resources\vendor\**\*" Link="Resources\vendor\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\kokoro-windows-synthesize.py" Link="Resources\kokoro-windows-synthesize.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
